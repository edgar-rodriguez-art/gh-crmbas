# =============================================================================
# crmbas · Variables de entorno
#
# Copia este archivo a .env.local para desarrollo. En producción se configuran
# en Vercel → Settings → Environment Variables, nunca en el repositorio.
# =============================================================================

# --- Supabase (proyecto db-crmbas, región eu-west-3) -------------------------

# Dirección del proyecto. Pública: viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública. Toda consulta que la usa queda sujeta a las políticas RLS,
# así que exponerla al navegador es el uso previsto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. Ignora RLS por completo: solo se usa en el servidor, para
# la cola de correo y los puntos de entrada de n8n. Nunca con el prefijo
# NEXT_PUBLIC_. Se obtiene en Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n (flujo wf-crmbas) ---------------------------------------------------

# Punto de entrada del webhook del flujo.
N8N_WEBHOOK_URL=

# Secreto con el que crmbas firma lo que envía a n8n (HMAC-SHA256).
# Genera uno con: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Secreto con el que n8n firma lo que devuelve a crmbas. Usa un valor distinto
# del anterior: cada dirección tiene su propia clave.
CRM_WEBHOOK_SECRET=

# --- Aplicación --------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
